# Public site URL used for metadata, sitemap, robots, and Open Graph.
# Use your real HTTPS origin in production. This value is inlined at build time.
# Local development can override it to http://localhost:3000 in .env.local.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Optional public origin of the CTF app when it runs on a different domain/port.
# Leave empty when the CV and CTF app share one origin.
NEXT_PUBLIC_CTF_URL=
# Bind address and port for the custom server (server.ts). Never bind to the
# Docker-provided HOSTNAME value; use 0.0.0.0 for containers.
HOST=0.0.0.0
PORT=3000
# Docker Compose only: host port and PostgreSQL password. Replace the password
# with a long random value in .env; never commit .env.
APP_PORT=3000
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Optional: Supabase gallery + authenticated studio.
# Both values are inlined at build time. In Docker Compose they are forwarded
# as build args, so set them before `docker compose build`.
# Use the anon/publishable key only. Never place a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: contact form delivery through Resend (https://resend.com).
# All three values are required before the form will report success.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Vallozza Portfolio <onboarding@resend.dev>
CONTACT_TO_EMAIL=

# ---------------------------------------------------------------------------
# CTF INTELLIGENCE — AI CYBERSECURITY SOLVER
# ---------------------------------------------------------------------------

# Access gate. If empty, /ctf is open (development only).
CTF_ACCESS_PASSWORD=

# Master key for AES-256-GCM encryption of provider API keys (>= 16 chars).
# If empty, a 32-byte key file is generated at .data/master.key (mode 0600).
CTF_MASTER_KEY=

# Data directory for the JSON store and uploads. Defaults to .data
CTF_DATA_DIR=.data
# Per-challenge workspace root for artifacts. Defaults to C:\CTF-AI.
# In Linux/container deployments use an absolute path such as /data/ctf-ai.
CTF_WORKSPACE_ROOT=

# PostgreSQL backend. If set, the JSON store is bypassed and all records are
# persisted in PostgreSQL (schema is created automatically on first use).
# Example: postgres://ctf:secret@127.0.0.1:5432/ctf_intelligence
CTF_DATABASE_URL=
# Optional pool size for the PostgreSQL client. Defaults to 8.
CTF_PG_POOL_SIZE=8

# Maximum upload size in MB (1-200). Defaults to 25.
CTF_MAX_UPLOAD_MB=25

# Execution policy. Keep both disabled unless you understand the risk.
# Host tools run fixed-argument CLI profiles on uploaded files (no free shell).
CTF_HOST_TOOLS=0
# Docker sandbox: network none, read-only, non-root, resource limited.
CTF_SANDBOX_ENABLED=0
CTF_SANDBOX_IMAGE=ctf-intelligence-sandbox:latest
# Optional Python/FastAPI sidecar used for bounded artifact analysis.
CTF_PY_BACKEND_URL=http://127.0.0.1:3131

# Kali Linux terminal for the AI CTF Solver agent.
# Base image: npm run ctf:kali:build  (docker/ctf-kali/Dockerfile)
# Remote SSH build: npm run ctf:kali:remote:build (adds openssh-client + sshpass)
CTF_TERMINAL_IMAGE=ctf-kali-remote:latest
# Per-command timeout in ms (5.000-120.000). Default 20.000.
CTF_TERMINAL_TIMEOUT_MS=20000
# Container lifetime without activity, in minutes (min 15). Default 180.
CTF_TERMINAL_TTL_MINUTES=180
# Network is ACTIVE by default (bridge). Set to 0 for --network none.
CTF_TERMINAL_NETWORK=1
# Autonomous solver retry budget. Default 1,000,000 attempts; the wall-clock
# budget below normally stops the run first. Max 1 hour.
CTF_AGENT_MAX_ATTEMPTS=1000000
CTF_AGENT_TIME_BUDGET_MS=600000

# Autonomous remote SSH control. The allowlist is empty by default, which DENIES
# every endpoint. Add exact hosts, *.example.test, or IPv4 CIDR only for systems
# you are authorized to test. The host-key SHA256 fingerprint is required per
# profile/chat; it is never guessed.
CTF_REMOTE_ALLOWED_HOSTS=
CTF_REMOTE_ALLOWED_PORTS=22
CTF_REMOTE_ALLOW_NETWORK_SCAN=0

# picoGym / CyLab challenge endpoints. Keep strict mode and the per-message
# confirmation enabled in any public deployment. Empty host/port lists deny all
# remote challenge endpoints.
CTF_PICOCTF_MODE=1
CTF_PICOCTF_STRICT_ENDPOINTS=1
CTF_PICOCTF_REQUIRE_NETWORK_CONFIRMATION=1
CTF_PICOCTF_ALLOWED_HOSTS=
CTF_PICOCTF_ALLOWED_PORTS=

# Autonomous execution limits (separate from the legacy agent limits above).
CTF_AUTONOMOUS_MAX_ITERATIONS=8
CTF_AUTONOMOUS_MAX_STRATEGIES=5
CTF_AUTONOMOUS_MAX_REPEATED_COMMANDS=0
CTF_AUTONOMOUS_MAX_VERIFICATION_ATTEMPTS=3
CTF_AUTONOMOUS_TIME_BUDGET_MS=600000
CTF_AUTONOMOUS_COMMAND_TIMEOUT_MS=20000
CTF_AUTONOMOUS_MAX_OUTPUT_BYTES=64000
CTF_AUTONOMOUS_MAX_DECODE_DEPTH=4

# Adaptive reasoning engine limits.
# High-level reasoning iterations per answer (1-50). Default 8.
CTF_REASONING_MAX_ITERATIONS=8
# Alternative strategies offered per planning round (1-20). Default 5.
CTF_REASONING_MAX_STRATEGIES=5
# Identical command executions (0-10). Default 0 = skip duplicates.
CTF_REASONING_MAX_REPEATED_COMMANDS=0
# Explicit verification attempts (1-10). Default 3.
CTF_REASONING_MAX_VERIFICATION_ATTEMPTS=3
# Semantic similarity threshold for answer repetition (0.5-0.99). Default 0.82.
CTF_REASONING_SIMILARITY_THRESHOLD=0.82

# AI providers. Keys are read server-side only; never exposed to the browser.
# Settings UI keys are stored encrypted and take precedence over these.
CTF_OPENAI_API_KEY=
OPENAI_API_KEY=
CTF_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=
CTF_GEMINI_API_KEY=
GEMINI_API_KEY=

# Ollama runs locally and does not need a key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Any OpenAI-compatible endpoint (OpenRouter, vLLM, LM Studio, ...).
# Also used by the local llama.cpp setup: scripts/ctf-ai-setup.ps1 starts
# llama-server on 127.0.0.1:8080 and this provider needs no API key.
CTF_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
