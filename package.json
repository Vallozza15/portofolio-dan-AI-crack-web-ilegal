{
  "name": "vallozza-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Muhammad Vallozza Vito - personal portfolio",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --import tsx server.ts",
    "start:next": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "ctf:smoke": "tsx scripts/ctf-smoke.ts",
    "ctf:reasoning:smoke": "tsx scripts/ctf-reasoning-smoke.ts",
    "ctf:autonomous:smoke": "tsx scripts/ctf-autonomous-smoke.ts",
    "ctf:autonomous:acceptance": "tsx scripts/ctf-autonomous-acceptance.ts",
    "ctf:sidecars:verify": "node scripts/ctf-sidecars-verify.js",
    "ctf:picoctf:configure": "powershell -ExecutionPolicy Bypass -File scripts/ctf-picoctf-configure.ps1",
    "ctf:picoctf:verify": "tsx scripts/ctf-picoctf-verify.ts",
    "ctf:research:smoke": "tsx scripts/ctf-research-smoke.ts",
    "ctf:kali:remote:build": "docker build -t ctf-kali-remote:latest docker/ctf-kali-remote",
    "ctf:fixture:build": "docker build -t ctf-ssh-fixture:latest docker/ctf-ssh-fixture",
    "ctf:migrate": "tsx scripts/ctf-migrate.ts",
    "ctf:cleanup": "tsx scripts/ctf-cleanup.ts",
    "ctf:pg:start": "tsx scripts/ctf-pg-start.ts",
    "ctf:pg:stop": "tsx scripts/ctf-pg-stop.ts",
    "ctf:start": "powershell -ExecutionPolicy Bypass -File scripts/ctf-start-all.ps1",
    "ctf:py:start": "powershell -ExecutionPolicy Bypass -File scripts/ctf-py-start.ps1",
    "ctf:stop": "powershell -ExecutionPolicy Bypass -File scripts/ctf-stop-all.ps1",
    "ctf:sandbox:build": "docker build -t ctf-intelligence-sandbox:latest docker/ctf-sandbox",
    "ctf:kali:build": "docker build -t ctf-kali-sandbox:latest docker/ctf-kali"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "@types/pg": "^8.23.1",
    "framer-motion": "14.14.0",
    "geist": "1.9.2",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "resend": "6.38.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
